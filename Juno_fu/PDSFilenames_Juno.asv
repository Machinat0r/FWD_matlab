function filenames = PDSFilenames_Juno(Date,varargin)
%------written by Wending Fu, Sept.2025 in Beijing------------
% Input variable
% Date:'2017-08-23/2017-08-23';
% Instrument:'fgm'; %Instrument（optional）
% Cooridinates:'PC','SS','PL'; %mode（optional）
% Resolution:'','1','60'; %description（optional)
%% Input parser
parser = inputParser;
defaultInstrument = 'FGM';
defaultCooridnates = 'PC';
defaultResolution = '';
addParameter(parser, 'Instrument', defaultInstrument, @ischar);
addParameter(parser, 'Cooridinates', defaultCooridnates, @ischar);
addParameter(parser, 'Resolution', defaultResolution, @ischar);
parse(parser, varargin{:});
Instrument = parser.Results.Instrument;
Cooridinates = parser.Results.Cooridinates;
Resolution = parser.Results.Resolution;
%%
splitDate = regexp(Date,'/','split');
% startDate = regexp(splitDate{1},'(.+?)\T','match');
% endDate = regexp(splitDate{2},'(.+?)\T','match');

if ~isempty(Resolution), Resolution = ['r',num2str(resolution),'s_'];end

Parent 

https://pds-ppi.igpp.ucla.edu/data/JNO-J-3-FGM-CAL-V1.0/DATA/JUPITER/PC/PERI-00/

sc_ids=['&sc_ids=',sc_ids(1:end-1)];
url = ['https://lasp.colorado.edu/mms/sdc/public/files/api/v1/file_names/science?start_date=', ...
    splitDate{1},'&end_date=',splitDate{2},sc_ids,inst,drm,dpt];
options = weboptions('Timeout',5); 

ErrorTimes = 0;
while ErrorTimes <= 20
try
    sourcefile = webread(url,options);
    fprintf('文件目录爬取已完成\n')
    ErrorTimes = 666;
catch
    fprintf('连接超时，请挂vpn\n')
    ErrorTimes = ErrorTimes + 1;
end
end

% expression = '<a.+?href=\"(.+?)\">(.+?)</a>'; %识别网页中的链接
expression = 'mms[1234]_(.+?)\.cdf'; %识别cdf文件名
filenames = regexp(sourcefile,expression,'match');
filenames = unique(filenames);
% celldisp(filenames)
Identification(mfilename('fullpath'));
end